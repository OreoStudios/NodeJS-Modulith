{
  "name": "ojs-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.js",
    "test:web": "node --test examples/supportdesk/tests/*.test.js",
    "test:all": "npm test && npm run test:web"
  },
  "engines": {
    "node": ">=22"
  }
}
